# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Optional X/Twitter auth for the social sentiment analyst
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
TWITTER_BROWSER=
TWITTER_PROXY=

# Optional Tiger Open config for HK stock price/indicator routing
TIGER_CONFIG_PATH=
TIGER_PRIVATE_KEY_PATH=
TIGER_PRIVATE_KEY_PK1=
TIGER_ID=
TIGER_ACCOUNT=
TIGER_LICENSE=
TIGER_SECRET_KEY=
# If TIGER_CONFIG_PATH is empty, TradingAgents also auto-checks:
# ${TRADINGAGENTS_STATE_DIR:-~/.tradingagents}/tiger/tiger_openapi_config.properties

# Optional state dir for ChatGPT OAuth profiles used by `llm_provider=openai-codex`
TRADINGAGENTS_STATE_DIR=
